### Benchmark - Multi-database (PostgreSQL + Neo4j + MongoDB)
# @timeout = 600000
POST http://{{host}}/generate
Content-Type: application/json

{
  "idea": "movie management system with actors, directors, genres and reviews",
  "depth": 4,
  "targets": [
    {"db_type": "relational", "db_name": "postgresql", "db_version": "16"},
    {"db_type": "graph", "db_name": "neo4j", "db_version": "5.0"},
    {"db_type": "document", "db_name": "mongodb", "db_version": "7.0"}
  ]
}

### Benchmark - Full stack (5 databases)
# @timeout = 600000
POST http://{{host}}/generate
Content-Type: application/json

{
  "idea": "e-commerce platform with products, orders, customers, payments and shipping",
  "depth": 4,
  "targets": [
    {"db_type": "relational", "db_name": "postgresql", "db_version": "16"},
    {"db_type": "relational", "db_name": "mysql", "db_version": "8.0"},
    {"db_type": "graph", "db_name": "neo4j", "db_version": "5.0"},
    {"db_type": "document", "db_name": "mongodb", "db_version": "7.0"},
    {"db_type": "key_value", "db_name": "redis", "db_version": "7"}
  ],
  "model": "vertex_ai/claude-sonnet-4-6",
  "max_iterations": 5
}

