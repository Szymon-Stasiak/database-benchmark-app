POST http://{{host}}/generate
Content-Type: application/json

{
  "idea": "movie management system with actors, directors, genres and reviews",
  "depth": 4,
  "targets": [
    {"db_type": "relational", "db_name": "postgresql", "db_version": "16"}
  ]
}

